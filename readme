Visualization of vanilla MARDM:
    python sample.py --name MARDM_SiT_XL --text_prompt "A person is waving his left hand."


Visualization of source motion:
    python /root/workspace/MARDM/external/GMR/scripts/vis_npz_motion.py --npz_path /root/workspace/MARDM/data/semi_synthetic_v1_segments/11995_HAND_SNATCH-4_1_motion.npz

Convert humanml3d pickle to npz format (with fps interpolation from 20fps to 60fps and low-pass filtering):

    # Single file conversion:
    python utils/convert_humanml3d_to_npz.py --pickle_path /root/workspace/MARDM/data/G1ML3D_v1/joints/000000.pickle --output_path /root/workspace/MARDM/data/G1ML3D_v1/joints_npz/000000.npz --src_fps 20 --tgt_fps 60 --filter_cutoff 2 --filter_order 4
    
    # Batch conversion (process entire directory):
    python utils/convert_humanml3d_to_npz.py --input_dir /root/workspace/MARDM/data/G1ML3D_v1/joints --output_dir /root/workspace/MARDM/data/G1ML3D_v1/joints_npz --src_fps 20 --tgt_fps 60 --filter_cutoff 2 --filter_order 4
    
Visualization of converted humanml3d npz data:
    python /root/workspace/MARDM/external/GMR/scripts/vis_npz_motion.py --npz_path /root/workspace/MARDM/data/G1ML3D_v1/joints_npz/000000.npz --motion_fps 60

Visualize VAE comparison (original vs reconstructed):
    python vis_AE_comparison.py --npz_path checkpoints/beat_v2/AE/test_results/sample_0000.npz --output_path videos/ae_comparison.mp4 --robot g1_branco

Preprocess whisper feature of BEAT_v2:
    python utils/batch_whisper_features.py

Preprocess whisper feature of semi_synthetic_v1:
   
    python utils/batch_whisper_features.py --input_dir /root/workspace/MARDM/data/semi_synthetic_v1 --num_gpus 8 --num_workers 4
    

Compute mean and std of BEAT_v2, semi_synthetic_v1_segments, and G1ML3D_v1:
    python utils/cal_mean_std.py
    Note: This will calculate mean and std for BEAT_v2, semi_synthetic_v1_segments, and G1ML3D_v1 datasets.
          Results will be saved to their respective data directories (Mean.npy and Std.npy).

Train VAE on mixed dataset (BEAT_v2 + semi_synthetic_v1_segments) (8 GPUs):
    torchrun --nproc_per_node=8 --master_port=29501 train_AE.py --name AE --dataset_name mixed --batch_size 256 --epoch 50 --lr_decay 0.05 --distributed
    Note: batch_size is per GPU, so total batch size = 256 * 8 = 2048
    Note: Use --master_port to specify port (default: 29501, avoids 29500). Must use torchrun's --master_port, not environment variable.
    Note: Mixed dataset combines BEAT_v2 and semi_synthetic_v1_segments datasets for training.

Train VAE on mixed dataset (BEAT_v2 + semi_synthetic_v1_segments) (single GPU):
    python train_AE.py --name AE --dataset_name mixed --batch_size 2048 --epoch 10 --lr_decay 0.05

Evaluate VAE on mixed dataset (BEAT_v2 + semi_synthetic_v1_segments):
    python evaluation_AE.py --name AE --dataset_name mixed --model AE_Model --batch_size 256 --window_size 176

Train VAE on G1ML3D_v1 dataset (8 GPUs):
    torchrun --nproc_per_node=8 --master_port=29501 train_AE.py --name AE --dataset_name g1ml3d --batch_size 256 --epoch 50 --lr_decay 0.05 --distributed
    Note: batch_size is per GPU, so total batch size = 256 * 8 = 2048

Train VAE on G1ML3D_v1 dataset (single GPU):
    python train_AE.py --name AE --dataset_name g1ml3d --batch_size 256 --epoch 50 --lr_decay 0.05

Evaluate VAE on G1ML3D_v1 dataset:
    python evaluation_AE.py --name AE --dataset_name g1ml3d --model AE_Model --batch_size 256 --window_size 180

Test VAE on G1ML3D_v1 dataset and generate comparison videos:
    python test_AE_g1ml3d.py \
        --name AE \
        --model AE_Model \
        --dataset_name g1ml3d \
        --window_size 180 \
        --num_samples_per_dataset 10 \
        --sample_strategy diverse \
        --generate_videos \
        --num_video_samples 10 \
        --robot_type g1_brainco \
        --motion_fps 60 \
        --rate_limit

Test VAE on mixed dataset and generate comparison videos with audio:
    python test_AE_mixed.py \
        --name AE \
        --model AE_Model \
        --batch_size 256 \
        --window_size 320 \
        --num_samples_per_dataset 10 \
        --sample_strategy diverse \
        --generate_videos \
        --num_video_samples 10 \
        --robot_type g1_brainco \
        --motion_fps 60 \
        --rate_limit
    
    Note: This script samples 10 samples from BEAT_v2 and 10 samples from semi_synthetic_v1_segments (total 20 samples).
          Videos are generated with original audio merged from the source datasets.
          Use --sample_strategy diverse (default) to ensure different motions are selected.
          Options: sequential (order), diverse (spaced), random (completely random)


Train MARDM:
   
    # 通过 --audio_feature_mode 选择 audio 使用方式，默认 cross_attention；可选 prefix（audio 下采样 10 倍后拼在 motion 前，关闭 cross-attention）。
    # For audio-to-motion dataset (beat_v2) - 8 GPU training.
    # 默认 cross_attention:
    torchrun --master_port 29504 --nproc_per_node=8 train_MARDM.py --name MARDM_DDPM_XL_beat_v2_4fps --model "MARDM-DDPM-XL" --dataset_name beat_v2 --batch_size 64 --ae_name AE --epoch 2000 --milestones 20000 --max_motion_length 300 --save_every_epochs 500 --distributed

    # 使用 prefix 方式（--audio_feature_mode prefix）:
    torchrun --master_port 29504 --nproc_per_node=8 train_MARDM.py --name MARDM_DDPM_XL_beat_v2_4fps_prefix --model "MARDM-DDPM-XL" --dataset_name beat_v2 --batch_size 64 --ae_name AE --epoch 2000 --milestones 20000 --max_motion_length 300 --save_every_epochs 500 --audio_feature_mode prefix --distributed

    # 多卡训练说明：若出现“训到一半有 7 张卡先结束、loss 异常”等情况，多为 rank0 在写大 checkpoint 时其余 rank 已进入下一 epoch 的 backward，在 all-reduce 处一直等 rank0 导致 NCCL 超时退出。脚本已在每个 epoch 保存前后加 dist.barrier() 同步。若仍超时，可检查单卡是否 OOM 或数据异常（任一张卡崩溃会拖垮整组）。

Test MARDM (beat_v2):
   # 测试时 --audio_feature_mode 需与训练一致。默认 cross_attention；若用 prefix 训练的 checkpoint 请加 --audio_feature_mode prefix。
    # 1. 在test set上展示效果（默认 cross_attention）:
    python test_beat_v2.py --mode testset --name MARDM_SiT_XL_beat_v2 --model "MARDM-SiT-XL" --dataset_name beat_v2 --ae_name AE --num_test_samples 100 --batch_size 16

    # 若 checkpoint 为 prefix 方式训练，则加 --audio_feature_mode prefix:
    python test_beat_v2.py --mode testset --name MARDM_SiT_XL_beat_v2_prefix --model "MARDM-SiT-XL" --dataset_name beat_v2 --ae_name AE --num_test_samples 100 --batch_size 16 --audio_feature_mode prefix

    # 2. 从给定的audio wav文件生成motion并渲染成视频（默认 cross_attention）:
    python test_beat_v2.py --mode audio --name MARDM_SiT_XL_beat_v2 --model "MARDM-SiT-XL" --dataset_name beat_v2 --ae_name AE --audio_path /root/workspace/MARDM/data/BEAT_v2/1/1_wayne_0_2_2.wav --whisper_model base

    # 若为 prefix 方式训练的模型:
    python test_beat_v2.py --mode audio --name MARDM_SiT_XL_beat_v2_prefix --model "MARDM-SiT-XL" --dataset_name beat_v2 --ae_name AE --audio_path /root/workspace/MARDM/data/BEAT_v2/1/1_wayne_0_2_2.wav --whisper_model base --audio_feature_mode prefix

Test MARDM (mixed):
   
    # 1. 在test set上展示效果:
    python test_beat_v2.py --mode testset --name MARDM_SiT_XL_mixed --model "MARDM-SiT-XL" --dataset_name mixed --ae_name AE --num_test_samples 100 --batch_size 16

    # 2. 从给定的audio wav文件生成motion并渲染成视频（支持长音频）:
    python test_beat_v2.py --mode audio --name MARDM_SiT_XL_mixed --model "MARDM-SiT-XL" --dataset_name mixed --ae_name AE --audio_path /root/workspace/MARDM/data/BEAT_v2/1/1_wayne_0_2_2.wav --whisper_model base
    
    # 3. 从长音频文件生成motion（自动分段处理）:
    python test_beat_v2.py --mode audio --name MARDM_SiT_XL_mixed --model "MARDM-SiT-XL" --dataset_name mixed --ae_name AE --audio_path /path/to/long_audio.wav --whisper_model base

Test MARDM (semi_synthetic):
   
    # 1. 在test set上展示效果:
    python test_beat_v2.py --mode testset --name MARDM_SiT_XL_semi_synthetic --model "MARDM-SiT-XL" --dataset_name semi_synthetic --ae_name AE --num_test_samples 100 --batch_size 16

    # 2. 从给定的audio wav文件生成motion并渲染成视频（支持长音频）:
    python test_beat_v2.py --mode audio --name MARDM_SiT_XL_semi_synthetic --model "MARDM-SiT-XL" --dataset_name semi_synthetic --ae_name AE --audio_path /root/workspace/MARDM/data/BEAT_v2/1/1_wayne_0_2_2.wav --whisper_model base



Process semi_synthetic_v1 to segments:

 python3 utils/preprocess_semi_synthetic.py \
  --data_dir /root/workspace/MARDM/data/semi_synthetic_v1 \
  --motion_stat_dir /root/workspace/MARDM/data/motion_stat \
  --output_dir /root/workspace/MARDM/data/semi_synthetic_v1_segments \
  --clip_version ViT-B/32 \
  --device cuda


Train MARDM on mixed data:
    # 在混合数据集上训练 MARDM (8 GPU):
    torchrun --master_port 29503 --nproc_per_node=8 train_MARDM.py \
    --name MARDM_SiT_XL_mixed \
    --model "MARDM-SiT-XL" \
    --dataset_name mixed \
    --batch_size 16 \
    --ae_name AE \
    --milestones 20000 \
    --max_motion_length 300 \
    --distributed

Train MARDM on semi-synthetic (text prompt only):
    # 仅在 semi-synthetic 上使用 text prompt 训练：仅文本 + 前60帧 -> 预测后240帧，无 audio、无 cross-attention。
   

    # 多卡 (例如 8 GPU):
    torchrun --master_port 29503 --nproc_per_node=8 train_MARDM.py \
        --name MARDM_SiT_XL_semi_synthetic_text_only \
        --model "MARDM-SiT-XL" \
        --dataset_name semi_synthetic \
        --ae_name AE \
        --batch_size 32 \
        --epoch 2000 \
        --max_motion_length 300 \
        --milestones 50000 \
        --lr 2e-4 \
        --distributed

Train MARDM on G1ML3D_v1 (text prompt only):
    # 在 G1ML3D_v1 上使用 text prompt 训练：仅文本 + 前60帧 -> 预测后240帧，无 audio、无 cross-attention。
   

    # 多卡 (例如 8 GPU):
    torchrun --master_port 29504 --nproc_per_node=8 train_MARDM.py \
        --name MARDM_SiT_XL_g1ml3d_text_only \
        --model "MARDM-SiT-XL" \
        --dataset_name g1ml3d \
        --ae_name AE \
        --batch_size 32 \
        --epoch 2000 \
        --max_motion_length 300 \
        --milestones 50000 \
        --lr 2e-4 \
        --distributed

Test MARDM on G1ML3D_v1 (text2motion):
    # 1. 在验证集上评测（预测 + 真值 npz，可选生成对比视频）:
    python test_g1ml3d.py --mode testset --name MARDM_SiT_XL_g1ml3d_text_only --num_test_samples 100 --batch_size 16
    python test_g1ml3d.py --mode testset --name MARDM_SiT_XL_g1ml3d_text_only --num_test_samples 20 --generate_videos --robot_type g1_brainco --motion_fps 60

    # 2. 从文本描述生成动作（前60帧为零姿态条件，生成后240帧）:
    python test_g1ml3d.py --mode text --name MARDM_SiT_XL_g1ml3d_text_only --text_prompt "A person is waving his left hand." --generate_videos --robot_type g1_brainco --motion_fps 60

   




