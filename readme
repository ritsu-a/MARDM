Visualization of converted humanml3d npz data:
    python /root/workspace/MARDM/external/GMR/scripts/vis_npz_motion.py --npz_path /root/workspace/MARDM/data/semi_synthetic_v2_segments/1_ARMS_SPHERICAL-6_0_motion.npz --motion_fps 60

semi_synthetic text2motion（v2 段：*_motion.npz 动作 + *_clip_description.npy CLIP 特征）:
    生成 train/val 划分（只保留同时有 motion.npz 与 clip_description.npy 的段）:
    python scripts/split_semi_synthetic.py --segment_dir ./data/semi_synthetic_v2_segments --train_ratio 0.9 --val_ratio 0.1
    # 若 CLIP 特征在 v1、动作用 v2，可指定:  --clip_dir ./data/semi_synthetic_v1_segments

    训练前需在 segment 目录或 --mean_std_dir 下提供 Mean.npy、Std.npy（可与 BEAT mixed VAE 共用，复制自 ./data/BEAT_v2 或对应 VAE 输出目录）。

    在 semi_synthetic_v2_segments 上训练 MARDM（text2motion，条件为预计算 CLIP 特征）:
    CUDA_VISIBLE_DEVICES=3 python train_MARDM_g1ml3d.py \
        --dataset_dir ./data/semi_synthetic_v2_segments \
        --use_semi_synthetic \
        --name MARDM_semi_synth \
        --ae_checkpoint_dir ./checkpoints/mixed/AE/model \
        --ae_checkpoint_name latest.tar \
        --mean_std_dir ./data/BEAT_v2 \
        --batch_size 64 \
        --max_motion_length 300 \
        --epoch 3000 \
        --lr 2e-4 \
        --checkpoints_dir ./checkpoints
    # 若 CLIP 特征从 v1 读取:  --clip_segments_dir ./data/semi_synthetic_v1_segments
    # 默认为「整段预测」（如 300 帧）；若要用「前 64 帧作条件预测后 224 帧」（共 288 帧）则加上:  --use_prefix_condition

Train G1ML3D vae:
    python train_AE_g1ml3d.py \
        --dataset_dir ./data/G1ML3D_v1 \
        --name AE_g1ml3d \
        --batch_size 256 \
        --window_size 64 \
        --epoch 10 \
        --lr 2e-4 \
        --checkpoints_dir ./checkpoints

Test G1ML3D vae:
    python evaluation_AE_g1ml3d.py \
    --dataset_dir ./data/G1ML3D_v1 \
    --name AE_g1ml3d \
    --split_file val.txt \
    --checkpoint_name latest.tar \
    --checkpoints_dir ./checkpoints \
    --num_vis_samples 5 \
    --vis_robot g1_brainco \
    --motion_fps 60

Train G1ML3D MARDM (DDPM):
    python train_MARDM_g1ml3d.py \
        --dataset_dir ./data/G1ML3D_v1 \
        --name MARDM_g1ml3d \
        --ae_name AE_g1ml3d \
        --ae_checkpoint_name latest.tar \
        --batch_size 128 \
        --max_motion_length 196 \
        --epoch 3000 \
        --lr 2e-4 \
        --checkpoints_dir ./checkpoints

Test G1ML3D MARDM (DDPM), e.g. checkpoint_epoch_600:
    python evaluation_MARDM_g1ml3d.py \
        --dataset_dir ./data/G1ML3D_v1 \
        --name MARDM_g1ml3d \
        --ae_name AE_g1ml3d \
        --split_file val.txt \
        --checkpoint_name checkpoint_epoch_3000.tar \
        --checkpoints_dir ./checkpoints \
        --num_vis_samples 5 \
        --vis_robot g1_brainco \
        --motion_fps 60
    # Or use full path: --checkpoint_name /root/workspace/MARDM/checkpoints/g1ml3d/MARDM_g1ml3d/model/checkpoint_epoch_600.tar


生成 train/val/test 划分（适用于新数据集如 BEAT_v2，需先有 joints_npz 与可选 texts）:
    python scripts/split_train_test.py --dataset_dir ./data/BEAT_v2
    # 仅 train+test、无 val:  --no_val
    # 自定义比例:  --train_ratio 0.85 --test_ratio 0.15

BEAT_v2 先切片、再分 split（300 帧 motion + 250 帧 whisper，50:60）:
    python scripts/beat_segment_to_npz.py --dataset_dir ./data/BEAT_v2 --id_list train.txt test.txt --train_ratio 0.8 --seed 42
    # 先对全部 id 切段，再打乱后按 train_ratio 划分为 train/test
    # 输出: ① 每段单独 segment/{id}.npz  ② segment_train.npz / segment_test.npz、segment_train.txt / segment_test.txt



测试 VAE 时直接读 BEAT 切好的 segment（优先 segment_test.npz），checkpoint 用 mixed：
python evaluation_AE_g1ml3d.py \
    --dataset_type beat --use_segment \
    --dataset_dir ./data/BEAT_v2 \
    --name AE_mixed \
    --model_dir ./checkpoints/mixed/ae/model \
    --ae_width 1024 \
    --split_file segment_test.txt \
    --checkpoint_name latest.tar \
    --checkpoints_dir ./checkpoints \
    --num_vis_samples 5 \
    --vis_robot g1_brainco \
    --motion_fps 60

在 BEAT segment 上训练 MARDM（需先完成 BEAT 切片与 mixed VAE）：
    python train_MARDM_g1ml3d.py \
        --dataset_dir ./data/BEAT_v2 \
        --use_segment \
        --name MARDM_beat \
        --ae_checkpoint_dir ./checkpoints/mixed/AE/model \
        --ae_checkpoint_name latest.tar \
        --batch_size 64 \
        --epoch 3000 \
        --lr 2e-4 \
        --checkpoints_dir ./checkpoints
    # use_segment 时默认 --cond_mode whisper；max_motion_length=300

    前 64 帧 + 音频预测后 224 帧（共 288 帧）：
    python train_MARDM_g1ml3d.py \
        --dataset_dir ./data/BEAT_v2 \
        --use_segment \
        --use_prefix_condition \
        --name MARDM_beat \
        --ae_checkpoint_dir ./checkpoints/mixed/AE/model \
        --ae_checkpoint_name latest.tar \
        --batch_size 64 \
        --epoch 3000 \
        --lr 2e-4 \
        --checkpoints_dir ./checkpoints

在 BEAT segment 上测试 MARDM：
    python evaluation_MARDM_g1ml3d.py \
        --dataset_dir ./data/BEAT_v2 \
        --use_segment \
        --name MARDM_beat \
        --ae_checkpoint_dir ./checkpoints/mixed/AE/model \
        --split_file segment_test.txt \
        --checkpoint_name checkpoint_epoch_400.tar \
        --checkpoints_dir ./checkpoints \
        --num_vis_samples 20 \
        --max_eval_samples 20 \
        --num_render_npz 0 \
        --vis_robot g1_brainco \
        --motion_fps 60

从训练集取 segment、每生成一段立即可视化（输出到 eval_train/visualizations）：

    CUDA_VISIBLE_DEVICES=2 python evaluation_MARDM_g1ml3d_train_vis.py \
        --dataset_dir ./data/BEAT_v2 \
        --name MARDM_beat \
        --ae_checkpoint_dir ./checkpoints/mixed/AE/model \
        --checkpoint_name checkpoint_epoch_400.tar \
        --checkpoints_dir ./checkpoints \
        --num_segments 20 \
        --vis_robot g1_brainco \
        --motion_fps 60
    # 默认用 segment_train.txt；可加 --shuffle_train 随机取段

在测试集上同样方式 eval（只读 20 段、逐段生成并可视化，输出到 eval_test/）：
    CUDA_VISIBLE_DEVICES=2 python evaluation_MARDM_g1ml3d_train_vis.py \
        --dataset_dir ./data/BEAT_v2 \
        --name MARDM_beat \
        --ae_checkpoint_dir ./checkpoints/mixed/AE/model \
        --checkpoint_name checkpoint_epoch_400.tar \
        --checkpoints_dir ./checkpoints \
        --split_file segment_test.txt \
        --num_segments 20 \
        --vis_robot g1_brainco \
        --motion_fps 60
    # 输出到 eval_test/visualizations、eval_test/generated_npz

train on 64 frame history

CUDA_VISIBLE_DEVICES=2 python train_MARDM_g1ml3d.py \
    --dataset_dir ./data/BEAT_v2 \
    --use_segment \
    --use_prefix_condition \
    --name MARDM_beat_64history \
    --ae_checkpoint_dir ./checkpoints/mixed/AE/model \
    --ae_checkpoint_name latest.tar \
    --batch_size 64 \
    --epoch 3000 \
    --lr 2e-4 \
    --checkpoints_dir ./checkpoints